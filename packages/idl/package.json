{
    "name": "@explorer/idl",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "prebuild": "rm -rf dist",
        "build": "node scripts/build.mjs",
        "build:programs": "pnpm --filter \"@explorer/idl-program-*\" build",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "pretest": "pnpm run build:programs",
        "test": "vitest run && pnpm run test:integration",
        "pretest:integration": "pnpm run build",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit"
    },
    "dependencies": {
        "@codama/dynamic-parsers": "1.1.30",
        "@codama/nodes-from-anchor": "1.3.8"
    },
    "devDependencies": {
        "@explorer/idl-program-simple": "workspace:*",
        "@explorer/idl-program-simple-031": "workspace:*",
        "oxc-transform": "^0.137.0",
        "oxlint": "^1.71.0",
        "typescript": "catalog:tooling",
        "vitest": "catalog:vitest"
    },
    "peerDependencies": {
        "@coral-xyz/anchor": "^0.30.1",
        "@solana/kit": "^6.5.0",
        "codama": "^1.5.0"
    }
}
